# Machine-specific settings. Copy to .env (never committed) only where needed:
#   cp .env.example .env
# The Mac (Apple Silicon) needs no .env at all.

# --- Label Studio -----------------------------------------------------------------
# Same version on every machine (its database is copied between them).
# Find the version in use:  docker exec label-studio label-studio version
# LABEL_STUDIO_VERSION=latest

# --- Hospital tower (Linux x86) ---------------------------------------------------
# With an NVIDIA GPU (check with: nvidia-smi):
# YOLO_IMAGE=ultralytics/ultralytics:latest
# COMPOSE_FILE=docker-compose.yml:docker-compose.gpu.yml
#
# Without GPU:
# YOLO_IMAGE=ultralytics/ultralytics:latest-cpu
#
# Run the containers as yourself so the files they write stay yours
# (values from: id -u / id -g). Docker Desktop on macOS does not need this.
# TRAINER_USER=1000:1000
# LABEL_STUDIO_USER=1000:0

# --- Data folder ------------------------------------------------------------------
# Default: ../3DRespiView-Results/training (next to this repository).
# TRAINING_DATA=/absolute/path/to/3DRespiView-Results/training
